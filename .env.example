# FRONTEND ENVIRONMENT VARIABLES
# Copy ke .env.local untuk development
# Set di Vercel dashboard untuk production

# Backend API URL (pakai domain Render/Vercel production)
NEXT_PUBLIC_API_URL=https://api.stisipsu.ac.id/

# Google OAuth Client ID (untuk login dengan Google — opsional)
# 1. Buka https://console.cloud.google.com/apis/credentials
# 2. Buat OAuth 2.0 Client ID (Web application)
# 3. Tambahkan Authorized JavaScript origins: http://localhost:3000, https://stisipsu-fe.vercel.app
# 4. Isi Client ID di sini, lalu fitur login Google otomatis aktif
NEXT_PUBLIC_GOOGLE_CLIENT_ID=